# DeepSeek 配置：将此文件复制为 .env，只需填写你的 DeepSeek API Key。
# 保留 OPENAI_ 前缀是为了兼容 SDK，并不代表使用 OpenAI 的服务或密钥。
OPENAI_API_KEY=
# 官方 Chat Completions API 根地址，不要追加 /chat/completions。
OPENAI_BASE_URL=https://api.deepseek.com
# 默认关闭思考；问题拆解/单篇输出最多 4096，综合回答最多 8192 tokens。
OPENAI_MODEL=deepseek-flash
# 仍支持其他兼容服务：替换上述地址、模型和对应密钥即可。
