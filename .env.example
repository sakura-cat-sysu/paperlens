# 本地开发配置。生产配置见 deploy/production.env.example。
APP_ORIGIN=http://127.0.0.1:5188
DATABASE_URL=postgresql+psycopg://paperlens:development-only@127.0.0.1:55432/paperlens
CELERY_BROKER_URL=amqp://paperlens:development-only@127.0.0.1:5673//
# 开放注册时仍需管理员签发的邀请码。
ALLOW_REGISTRATION=false
DAILY_ANALYSES=20
MAX_ACTIVE_JOBS=2
MAX_DOCUMENTS=100

# 本地默认保存到 .data/documents；生产支持私有 S3 / OSS / COS。
STORAGE_BACKEND=local
STORAGE_ROOT=.data/documents

# OPENAI_ 是兼容 SDK 的变量前缀；默认实际调用 DeepSeek。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
