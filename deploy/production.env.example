# 复制到 /opt/paperlens/.env，chmod 600；此文件不进入镜像。
DOMAIN=paperlens.example.com
APP_ORIGIN=https://paperlens.example.com

# 替换为独立随机字母数字密码，避免 URL 转义问题。
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
RABBITMQ_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://paperlens:REPLACE_WITH_RANDOM_PASSWORD@postgres:5432/paperlens
CELERY_BROKER_URL=amqp://paperlens:REPLACE_WITH_ANOTHER_RANDOM_PASSWORD@rabbitmq:5672//
ALLOW_REGISTRATION=false
ALLOW_GUESTS=true
GUEST_DAILY_ANALYSES=10
GUEST_MAX_DOCUMENTS=10
GUEST_ENTRIES_PER_WINDOW=30
DAILY_ANALYSES=20
MAX_ACTIVE_JOBS=2
MAX_DOCUMENTS=100

# 生产推荐私有对象存储。先创建私有 Bucket，开启加密、版本与生命周期策略。
STORAGE_BACKEND=s3
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 如先使用服务器持久卷，改 STORAGE_BACKEND=local 并安排异机文件备份。
STORAGE_ROOT=/data/documents

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
# chat / responses / messages；流式内容完整接收后再校验。
OPENAI_PROTOCOL=chat
OPENAI_STREAM=false
